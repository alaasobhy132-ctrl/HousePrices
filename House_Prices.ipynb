    "sale_counts = df[\"saletype\"].value_counts().reset_index()\n",
    "sale_counts.columns = [\"saletype\", \"count\"]\n",
    "\n",

    "fig = px.pie(sale_counts, \n",
    "             names=\"saletype\", \n",
    "             values=\"count\",\n",
    "             title=\"Distribution of Sale Types\",\n",
    "             color_discrete_sequence=px.colors.qualitative.Set1)\n",
    "\n",
    "fig.show()"
   ]
