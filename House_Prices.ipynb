   "source": [
    "df[\"quality_group\"] = pd.cut(df[\"overallqual\"], \n",
    "                             bins=[0,3,6,8,10],\n",
    "                             labels=[\"Poor(1-3)\", \"Average(4-6)\", \"Good(7-8)\", \"Excellent(9-10)\"])\n",
    "\n",
    "# حساب متوسط السعر لكل مجموعة جودة\n",
    "avg_price = df.groupby(\"quality_group\")[\"saleprice\"].mean().reset_index()\n",
    "\n",
    "# رسم بار تشارت\n",
    "fig = px.bar(avg_price, \n",
    "             x=\"quality_group\", \n",
    "             y=\"saleprice\",\n",
    "             title=\"Average Sale Price by House Quality\",\n",
    "             labels={\"saleprice\": \"Average Sale Price\"},\n",
    "             color=\"saleprice\",\n",
    "             color_continuous_scale=\"Oranges\")\n",
    "\n",
    "fig.show()"
   ]
  },
